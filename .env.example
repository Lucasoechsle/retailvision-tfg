# Supabase — crear un proyecto en https://supabase.com y copiar las credenciales
# (Project Settings > API)

# URL del proyecto
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública (se expone en el navegador, protegida por Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key

# Clave de servicio — SOLO servidor. Omite RLS: nunca exponerla en el cliente
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key
