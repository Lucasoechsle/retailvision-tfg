# ── Conexión con el backend ──────────────────────────────────────────────
# URL de la aplicación (local o desplegada)
BACKEND_URL=http://localhost:3000

# Clave del dispositivo: se genera al dar de alta el edge device en el dashboard
# (Sucursal > Dispositivos > Nuevo). Se envía en el header X-Device-Key
DEVICE_API_KEY=tu_device_key

# ── Cámara ───────────────────────────────────────────────────────────────
# 0 = webcam integrada | ruta a un archivo de video | URL RTSP de una cámara IP
CAMERA_SOURCE=0

# ── Modelo de visión ─────────────────────────────────────────────────────
YOLO_MODEL=yolov8n.pt
CONFIDENCE_THRESHOLD=0.5

# ── Ventana de previsualización (útil para calibrar; desactivar en producción)
SHOW_DISPLAY=true
DISPLAY_WIDTH=960
DISPLAY_HEIGHT=720

# ── Mapa de calor ────────────────────────────────────────────────────────
HEATMAP_GRID_WIDTH=20
HEATMAP_GRID_HEIGHT=15

# ── Intervalos de envío (segundos) ───────────────────────────────────────
# Valores de producción: 300 / 3600 / 300
# Para una demo conviene bajarlos (ej. 15) para ver los datos al instante
COUNT_INTERVAL=300
HEATMAP_INTERVAL=3600
ZONE_INTERVAL=300
